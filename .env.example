# Copie para .env e preencha. O .env não vai para o git.

# Chave da API do Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Opcional: https://huggingface.co/settings/tokens — evita o aviso de
# "unauthenticated requests" e dá rate limit maior ao baixar o modelo local
# de embeddings. Sem token, tudo funciona igual, só um pouco mais devagar.
HF_TOKEN=

# Conexão com o Postgres + pgvector (bate com o docker-compose.yml)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/agente_ead

# Embeddings rodam localmente (HuggingFace/sentence-transformers), sem cota de API
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
# Chat via Gemini
CHAT_MODEL=gemini-3.6-flash

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Retrieval
TOP_K=5
# Abaixo desse score de relevância (0..1) o agente responde "não encontrei na base"
RELEVANCE_THRESHOLD=0.35

# Triagem por assunto: a pergunta de outro departamento (cobranca, diploma,
# rematricula...) e encaminhada com o contato certo ANTES do retrieval, sem
# gastar RAG nem LLM. Categorias e e-mails em ENCAMINHAMENTOS
# (app/core/config.py). Com false, a pergunta volta a seguir para o RAG.
TRIAGEM_ENABLED=true

# Fallback de busca externa: quando o retrieval nao devolve nada, o agente
# procura nos dominios publicos oficiais (allowlist em app/core/config.py)
# antes de encaminhar para a secretaria. Com false, volta ao comportamento
# anterior: responde "nao encontrei na base" e para por ai.
WEB_FALLBACK_ENABLED=true
# Orcamento total da busca, em segundos (estourou, usa o que ja chegou)
WEB_SEARCH_TIMEOUT=8.0
# Similaridade minima (0..1) entre pergunta e snippet para chegar ao LLM
WEB_RELEVANCE_THRESHOLD=0.35

# Telemetria: 1 linha JSON por pergunta. Os dois destinos sao independentes.
# Mostra o log no terminal (stderr). Com false, a gravacao no banco continua.
TELEMETRY_STDERR_ENABLED=true
# Grava na tabela `telemetria` do Postgres. Com false, so o log no terminal.
TELEMETRY_DB_ENABLED=true
# Retencao dos registros, em dias. Expirados sao apagados na escrita.
TELEMETRY_RETENTION_DAYS=7
