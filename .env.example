# Copie para .env e preencha. O .env não vai para o git.

# Chave da API do Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Conexão com o Postgres + pgvector (bate com o docker-compose.yml)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agente_ead

# Modelos Gemini
EMBEDDING_MODEL=models/gemini-embedding-001
CHAT_MODEL=gemini-2.5-flash

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Retrieval
TOP_K=5
# Abaixo desse score de relevância (0..1) o agente responde "não encontrei na base"
RELEVANCE_THRESHOLD=0.35
