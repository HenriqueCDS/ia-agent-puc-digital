# Copie para .env e preencha. O .env não vai para o git.

# --- Cadeia de provedores de IA (app/providers/) ---
# Ordem de PRIORIDADE: o primeiro que responder vence. Provider sem chave sai
# da cadeia sozinho, entao para rodar so com o Gemini basta deixar as outras
# chaves em branco. Reordenar ou desligar um provedor e edicao daqui, sem
# deploy de codigo.
LLM_PROVIDERS=gemini,huggingface,groq,openrouter

# 1) Gemini — https://aistudio.google.com/apikey
# GOOGLE_API_KEY continua valendo (nome legado); com as duas preenchidas,
# GEMINI_API_KEY vence.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# 2) HuggingFace Inference Providers — usa o MESMO HF_TOKEN de baixo (o que ja
# baixa o modelo local de embeddings). Sem chave nova: e o fallback "de graca"
# antes de Groq/OpenRouter.
HF_MODEL=meta-llama/Llama-3.3-70B-Instruct

# 3) Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# 4) OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.2:free

# Modelo fora do catalogo da sua chave da erro 404 ("does not exist OR you do
# not have access to it" — a mensagem nao distingue os dois casos). Veja o que
# a SUA chave acessa, e qual linha daqui esta errada:
#     python -m scripts.modelos
# A cadeia nao cai por causa disso: o provider com modelo invalido sai de cena
# e o proximo responde. Mas a linha sai em ERROR no log, de proposito.

# Permite que o corpo do POST /ask traga `modelo` ([provider:]modelo) e escolha
# com que modelo responder — sem fallback e sem cache. DESLIGADO por padrao: a
# chave e nossa, entao quem escolhe o modelo escolhe o mais caro do catalogo, e
# RATE_LIMIT_DIARIO_* conta requisicoes, nao custo. Ligue em desenvolvimento.
# A CLI (scripts.ask --modelo) nao passa por este switch.
ASK_MODELO_OVERRIDE_ENABLED=false

# Com --modelo/modelo o cache fica DESLIGADO por padrao (nem le nem grava) —
# repetir a mesma pergunta com o mesmo override paga o LLM de novo toda vez.
# Ligue para que um override repetido sirva do cache. Seguro: o MODELO entra
# na chave do cache, entao um override nunca serve a resposta cacheada de
# outro modelo nem da cadeia normal.
MODELO_OVERRIDE_CACHE_ENABLED=false

# https://huggingface.co/settings/tokens — usado para baixar o modelo local de
# embeddings (rate limit maior; sem token, só um pouco mais devagar) E como
# credencial do provider `huggingface` da cadeia de chat acima (2 usos, 1 chave).
# Sem token, os embeddings continuam funcionando e o provider `huggingface`
# simplesmente sai da cadeia.
HF_TOKEN=

# Conexão com o Postgres + pgvector (bate com o docker-compose.yml)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/agente_ead

# Embeddings rodam localmente (HuggingFace/sentence-transformers), sem cota de
# API. BGE-M3 aceita até 8192 tokens (o antigo paraphrase-multilingual-mpnet-
# base-v2 truncava em 128, bem abaixo do CHUNK_SIZE de baixo). Trocar de modelo
# muda a dimensão do vetor — reingestão obrigatória (python -m scripts.ingest).
EMBEDDING_MODEL=BAAI/bge-m3
# Modelo do Gemini (o primeiro da cadeia). Os outros dois em GROQ_MODEL e
# OPENROUTER_MODEL, la em cima.
CHAT_MODEL=gemini-3.6-flash

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Retrieval
TOP_K=5
# Abaixo desse score de relevância (0..1) o agente responde "não encontrei na base"
RELEVANCE_THRESHOLD=0.35

# Triagem por assunto: a pergunta de outro departamento (cobranca, diploma,
# rematricula...) e encaminhada com o contato certo ANTES do retrieval, sem
# gastar RAG nem LLM. Categorias e e-mails em ENCAMINHAMENTOS
# (app/core/config.py). Com false, a pergunta volta a seguir para o RAG.
TRIAGEM_ENABLED=true

# Fallback de busca externa: quando o retrieval nao devolve nada, o agente
# procura nos dominios publicos oficiais (allowlist em app/core/config.py)
# antes de encaminhar para a secretaria. Com false, volta ao comportamento
# anterior: responde "nao encontrei na base" e para por ai.
WEB_FALLBACK_ENABLED=true
# Orcamento total da busca, em segundos (estourou, usa o que ja chegou)
WEB_SEARCH_TIMEOUT=8.0
# Similaridade minima (0..1) entre pergunta e snippet para chegar ao LLM
WEB_RELEVANCE_THRESHOLD=0.35

# Telemetria: 1 linha JSON por pergunta. Os dois destinos sao independentes.
# Mostra o log no terminal (stderr). Com false, a gravacao no banco continua.
TELEMETRY_STDERR_ENABLED=true
# Grava na tabela `telemetria` do Postgres. Com false, so o log no terminal.
TELEMETRY_DB_ENABLED=true
# Retencao dos registros, em dias. Expirados sao apagados na escrita.
TELEMETRY_RETENTION_DAYS=7

# --- Borda HTTP: seguranca (Sprint 2) ---
# Autenticacao por chave no header X-API-Key. Com true e API_KEYS vazia, as
# rotas /v1/ask e /v1/assuntos respondem 503 (fail-closed) — nunca liberam.
API_AUTH_ENABLED=true
# Uma chave POR INTEGRACAO: nome:chave,outro:chave. O nome vai para a
# telemetria (canal), o que permite atribuir custo e revogar so um consumidor.
# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

# Origens permitidas no CORS, separadas por virgula. Vazio = nenhuma chamada
# cruzada (a demo servida pela propria API nao precisa). "*" e ignorado.
CORS_ORIGINS=

# Rate limit: janela deslizante de 60s por consumidor...
RATE_LIMIT_POR_MINUTO=20
# ...e teto de custo do processo inteiro por dia (UTC).
RATE_LIMIT_DIARIO_GLOBAL=2000

# Timeout POR PROVIDER, em segundos, e quantas tentativas em cada um antes de
# cair para o proximo. Tentativas=1 de proposito: com tres provedores em fila,
# insistir com quem acabou de devolver 429 so gasta o tempo do aluno — fallback
# e perguntar a outro, retry e insistir com o mesmo.
# Pior caso de espera = LLM_TIMEOUT * nº de providers * LLM_TENTATIVAS_POR_PROVIDER.
LLM_TIMEOUT=30.0
LLM_TENTATIVAS_POR_PROVIDER=1
# Teto diario POR consumidor: nome:limite,outro:limite. So quem for listado
# tem teto proprio; os demais respondem ao global acima. Existe por causa da
# demo, cuja chave e publica no HTML (ver DEMO_CONSUMIDOR).
RATE_LIMIT_DIARIO_POR_CONSUMIDOR=demo:200

# --- Demo web (Sprint 3) ---
# Serve app/static/index.html em /demo (e redireciona / para la).
DEMO_ENABLED=true
# Nome, dentro de API_KEYS, da integracao que a demo usa. A chave e injetada no
# HTML pelo servidor, entao ela e publica para quem abrir o DevTools — por isso
# e uma integracao PROPRIA, com teto diario proprio acima: revoga-la ou estourar
# o teto dela nao afeta o AVA. Cadastre `demo:<chave>` em API_KEYS.
DEMO_CONSUMIDOR=demo
